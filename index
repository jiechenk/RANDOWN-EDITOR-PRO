  };

  pdf.fromData(htmlContent, options)
    .then(() => showToast('✅ PDF berhasil dibuat dan disimpan'))
    .catch(err => showToast('❌ Gagal membuat PDF: ' + err))
    .finally(() => {
      hiddenEls.forEach(el => el.style.display = '');
    });
}
   
           function sendToWhatsApp() {
               const phoneNumber = document.getElementById('whatsappNumber').value.trim();
               
               if (!phoneNumber) {
                   alert('⚠️ Nomor WhatsApp tidak boleh kosong!');
                   return;
               }
               
               const cleanNumber = phoneNumber.replace(/[^0-9]/g, '');
               if (cleanNumber.length < 10) {
                   alert('⚠️ Nomor WhatsApp tidak valid! Pastikan format benar (contoh: 628123456789)');
                   return;
               }
               
               closeModal('exportModal');
               showToast('📱 Menyiapkan pengiriman...');
               
               let text = `*${document.getElementById('title').value || 'Rundown Acara'}*\n`;
               text += `_${document.getElementById('subtitle').value || ''}_\n\n`;
               
               const eventDate = document.getElementById('eventDate').value;
               if (eventDate) {
                   const date = new Date(eventDate);
                   const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                   text += `📅 *Tanggal:* ${date.toLocaleDateString('id-ID', options)}\n`;
               }
               
               const location = document.getElementById('location').value;
               if (location) text += `📍 *Tempat:* ${location}\n`;
               
               const organizer = document.getElementById('organizer').value;
               if (organizer) text += `🏢 *Penyelenggara:* ${organizer}\n`;
               
               const participants = document.getElementById('participants').value;
               if (participants) text += `👥 *Target:* ${participants}\n\n`;
               
               text += `⏰ *JADWAL KEGIATAN:*\n\n`;
               
               const sortedSchedules = Object.keys(schedules).sort((a, b) => {
                   return schedules[a].startTime.localeCompare(schedules[b].startTime);
               });
               
               sortedSchedules.forEach(id => {
                   const s = schedules[id];
                   if (s.startTime && s.title) {
                       const duration = calculateDuration(s.startTime, s.endTime);
                       const durationText = duration ? ` _(${duration})_` : '';
                       text += `🕐 *${s.startTime} - ${s.endTime || '—'}*${durationText}\n`;
                       text += `${s.title}\n`;
                       if (s.description) text += `${s.description}\n`;
                       text += `\n`;
                   }
               });
               
               const equipment = document.getElementById('equipment').value;
               if (equipment) {
                   text += `\n🎯 *Perlengkapan:*\n${equipment}\n`;
               }
               
               const contact = document.getElementById('contact').value;
               if (contact) {
                   text += `\n📞 *Kontak:*\n${contact}\n`;
               }
               
               const notes = document.getElementById('notes').value;
               if (notes) {
                   text += `\n📝 *Catatan:*\n${notes}\n`;
               }
               
               text += `\n_Dibuat dengan Rundown Editor Universal_`;
               
               const encodedText = encodeURIComponent(text);
               const whatsappUrl = `https://wa.me/${cleanNumber}?text=${encodedText}`;
               
               setTimeout(() => {
                   if (window.cordova) {
                       window.open(whatsappUrl, '_system');
                   } else {
                       window.open(whatsappUrl, '_blank');
                   }
                   showToast('✅ Membuka WhatsApp...');
               }, 500);
           }
   
           function copyToClipboard() {
               let text = `${document.getElementById('title').value || 'Rundown Acara'}\n`;
               text += `${document.getElementById('subtitle').value || ''}\n\n`;
               
               const sortedSchedules = Object.keys(schedules).sort((a, b) => {
                   return schedules[a].startTime.localeCompare(schedules[b].startTime);
               });
               
               sortedSchedules.forEach(id => {
                   const s = schedules[id];
                   if (s.startTime && s.title) {
                       text += `${s.startTime} - ${s.endTime || '—'} | ${s.title}\n`;
                       if (s.description) text += `${s.description}\n`;
                       text += `\n`;
                   }
               });
               
               navigator.clipboard.writeText(text).then(() => {
                   closeModal('exportModal');
                   showToast('📋 Teks berhasil disalin');
               }).catch(() => {
                   alert('Gagal menyalin ke clipboard');
               });
           }
           
           function showToast(message) {
               const toast = document.createElement('div');
               toast.textContent = message;
               toast.style.cssText = `
                   position: fixed;
                   top: 80px;
                   left: 50%;
                   transform: translateX(-50%);
                   background: rgba(25,118,210,0.95);
                   color: white;
                   padding: 12px 24px;
                   border-radius: 25px;
                   font-size: 0.9rem;
                   font-weight: 600;
                   z-index: 10000;
                   box-shadow: 0 4px 15px rgba(0,0,0,0.3);
                   animation: slideDown 0.3s ease;
                   max-width: 90%;
                   text-align: center;
               `;
               
               document.body.appendChild(toast);
               
               setTimeout(() => {
                   toast.style.animation = 'slideUp 0.3s ease';
                   setTimeout(() => toast.remove(), 300);
               }, 2500);
           }
           
           function triggerHaptic() {
               if (navigator.vibrate) {
                   navigator.vibrate(10);
               } else if (navigator.notification && navigator.notification.vibrate) {
                   navigator.notification.vibrate(10);
               }
           }
           
           window.addEventListener('DOMContentLoaded', function() {
               if (window.cordova) {
                   document.addEventListener('deviceready', onDeviceReady, false);
               } else {
                   onDeviceReady();
               }
           });
   
           function onDeviceReady() {
               if (window.StatusBar) {
                   StatusBar.backgroundColorByHexString('#0d47a1');
                   StatusBar.styleLightContent();
               }
   
               const today = new Date().toISOString().split('T')[0];
               const dateInput = document.getElementById('eventDate');
               if (dateInput) dateInput.value = today;
   
               generatePreview();
               
               const wrapper = document.getElementById('swiperWrapper');
               const dots = document.querySelectorAll('.nav-dot');
               
               function updateNavDots(index) {
                   dots.forEach((dot, i) => {
                       dot.classList.toggle('active', i === index);
                   });
               }
               
               wrapper.addEventListener('scroll', () => {
                   const scrollLeft = wrapper.scrollLeft;
                   const sectionWidth = window.innerWidth;
                   const newSection = Math.round(scrollLeft / sectionWidth);
                   
                   if (newSection !== currentSection) {
                       currentSection = newSection;
                       updateNavDots(currentSection);
                       
                       if (currentSection === 3) {
                           generatePreview();
                       }
                   }
               });
               
               dots.forEach((dot, index) => {
                   dot.addEventListener('click', () => {
                       const sectionWidth = window.innerWidth;
                       wrapper.scrollTo({
                           left: sectionWidth * index,
                           behavior: 'smooth'
                       });
                       currentSection = index;
                       updateNavDots(index);
                   });
               });
               
               document.addEventListener('click', (e) => {
                   if (e.target.classList.contains('btn') || 
                       e.target.classList.contains('header-btn') || 
                       e.target.classList.contains('quick-btn') ||
                       e.target.classList.contains('event-type-card')) {
                       triggerHaptic();
                   }
               });
   
               document.querySelectorAll('.modal').forEach(modal => {
                   modal.addEventListener('click', (e) => {
                       if (e.target === modal) {
                           modal.classList.remove('active');
                       }
                   });
               });
               
               let lastTouchEnd = 0;
               document.addEventListener('touchend', function(event) {
                   const now = Date.now();
                   if (now - lastTouchEnd <= 300) {
                       event.preventDefault();
                   }
                   lastTouchEnd = now;
               }, false);
           }
      
    </script>
   
