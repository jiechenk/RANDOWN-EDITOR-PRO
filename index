           }
           
           function updateSchedule(id) {
               schedules[id] = {
                   startTime: document.getElementById(`startTime-${id}`).value,
                   endTime: document.getElementById(`endTime-${id}`).value,
                   title: document.getElementById(`title-${id}`).value,
                   description: document.getElementById(`description-${id}`).value
               };
               
               const duration = calculateDuration(schedules[id].startTime, schedules[id].endTime);
               const durationClass = getDurationClass(schedules[id].startTime, schedules[id].endTime);
               const headerElement = document.querySelector(`#schedule-${id} .activity-header h4`);
               if (headerElement) {
                   const durationBadge = duration ? `<span class="duration-badge ${durationClass}">${duration}</span>` : '';
                   headerElement.innerHTML = `Kegiatan #${id} ${durationBadge}`;
               }
   
               const conflict = checkTimeConflict(id, schedules[id].startTime, schedules[id].endTime);
               const conflictDiv = document.getElementById(`conflict-${id}`);
               
               if (conflict) {
                   if (conflict.type === 'invalid') {
                       conflictDiv.innerHTML = `<div class="time-conflict">${conflict.message}</div>`;
                   } else if (conflict.type === 'overlap') {
                       conflictDiv.innerHTML = `<div class="time-overlap-warning">${conflict.message}</div>`;
                   }
               } else {
                   conflictDiv.innerHTML = '';
